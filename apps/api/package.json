{
  "name": "@waveformr/api",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.ts",
    "start": "node server.ts",
    "test": "node --env-file-if-exists=.env --test main.test.ts lib/*.test.ts",
    "test:update": "UPDATE_SNAPSHOTS=1 pnpm test",
    "typecheck": "tsc",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "docker": "cd ../.. && docker build -f apps/api/Dockerfile -t waveformr-api --build-arg GIT_REVISION=$(git rev-parse HEAD) . && docker run --rm -p 8000:8000 --name wapi waveformr-api",
    "deploy": "cd ../.. && fly deploy --config apps/api/fly.toml --dockerfile apps/api/Dockerfile --build-arg GIT_REVISION=$(git rev-parse HEAD)"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "colord": "^2.10.0",
    "hono": "^4.13.13",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^5.0.5",
    "waveform-data": "^4.5.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.72.0",
    "sanitize-filename": "^1.6.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
